# Compose requires a non-empty, unique, local-only password before starting.
# Keep real values in .env, which is ignored by Git.
POSTGRES_PASSWORD=
SESSION_SECRET=
LOGIN_RATE_LIMIT=5/minute

# Optional host port; defaults are suitable for local development.
FRONTEND_PORT=5173

# Optional host port for the production-image local smoke stack.
PROD_FRONTEND_PORT=18080
